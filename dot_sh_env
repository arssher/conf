# ~/.sh_env -- the environment every shell needs, in one place.
#
# Who sources it, and why that covers everything:
#
#   ~/.zshenv    every zsh -- login or not, interactive or not, scripts
#                included. This is the widest reach any zsh file has.
#   ~/.bashrc    every bash, from the top of the file, above the interactivity
#                guard. Covers interactive shells and `ssh host 'command'`,
#                which bash reads .bashrc for because stdin is a socket.
#   ~/.profile   a login `sh`/dash, and a login bash -- neither reads .zshenv,
#                and dash does not read .bashrc either.
#
# Between the three, no shell that matters misses it. The one gap is
# `bash script.sh`, which reads only $BASH_ENV; scripts get the environment by
# inheritance instead.
#
# POSIX only. A login `sh` on Debian is dash, so nothing here may use bashisms:
# `[ ]` not `[[ ]]`, no arrays, no `source`, no `local`, no `+=`. It is also
# read by zsh, where unquoted parameter expansion does NOT word-split -- so
# every list below is spelled as literal quoted words rather than built in a
# variable.
#
# It must stay silent and fast. scp, rsync and `ssh host cmd` all read it
# through one of the three files above, and a single line of output on stdout
# corrupts their protocols.
#
# Public, and lives in the dotfiles repo. The private counterpart is
# ~/.global_vars, sourced at the end: same job, but for what must not be in a
# public repo.

# Guarded with an exported SH_ENV_LOADED, exactly the way .global_vars guards
# itself. Exported on purpose: PATH then gets built once per session tree
# rather than once per nested shell. The cost is that re-reading the file after
# editing it needs the guard cleared first -- that is the `ser` alias in
# .bashrc, mirroring `gvr`.
# Re-read this file after editing it. A plain `. ~/.sh_env` is a no-op while
# the guard below is set, and ~/.global_vars guards itself the same way with
# GLOBAL_VARS_LOADED, so both have to be cleared -- which covers the private
# half too, since this file sources it at the end.
#
# A function here rather than an alias in .bashrc: zsh then gets it as well,
# from the one definition, and it works in a non-interactive shell, where
# aliases are not expanded.
#
# Defined ABOVE the guard on purpose. The guard is exported, so in a nested
# shell the rest of this file is skipped -- and a function, unlike the
# environment, is not inherited. Below the guard it would be missing in exactly
# the shells someone is most likely to type it in.
source_env() {
    unset SH_ENV_LOADED GLOBAL_VARS_LOADED
    . "$HOME/.sh_env"
}

if [ -n "${SH_ENV_LOADED:-}" ]; then
    return 0
fi
export SH_ENV_LOADED=1

# ------------------------------------------------------------
# PATH

# Prepended, so these win over the system copies. Each is guarded against a
# second entry anyway: the guard above normally makes that impossible, but the
# file is also re-read by hand with SH_ENV_LOADED unset.
for d in "$HOME/bin" "$HOME/.local/bin"; do
    [ -d "$d" ] || continue
    case ":${PATH}:" in
        *":$d:"*) ;;
        *) PATH="$d:$PATH" ;;
    esac
done
unset d

# Appended, not prepended: these are my own scripts and none of them should
# shadow a system command of the same name.
case ":${PATH}:" in
    *":$HOME/.bash_scripts/bin:"*) ;;
    *) PATH="$PATH:$HOME/.bash_scripts/bin" ;;
esac

export PATH

# Toolchains, which are here for the PATH they bring. Last, so their own
# directories end up in front of the ones above: cargo's and deno's env files
# each prepend and export PATH themselves, and nvm manages its own.

# nvm. Sourced rather than run, because `nvm` is a shell function: switching
# node version means editing the current shell's PATH, which a subprocess
# cannot do. Safe in a POSIX file -- upstream says it "works on any
# POSIX-compliant shell (sh, dash, ksh, zsh, bash)". The completion beside it
# is bash-specific and stays in .bashrc.
export NVM_DIR="$HOME/.nvm"
[ -s "$NVM_DIR/nvm.sh" ] && . "$NVM_DIR/nvm.sh"

# rustup and deno each append their own source line to whatever rc files they
# find -- for zsh that is ~/.zshenv, which chezmoi manages, so the installer's
# edit would be reverted by the next apply. Sourcing them from here instead
# keeps it in one place; bootstrap_mac.sh passes --no-modify-path to match.
# Both env files guard their own prepend, so a second source is a no-op.
if [ -f "$HOME/.cargo/env" ]; then
    . "$HOME/.cargo/env"
fi
if [ -f "$HOME/.deno/env" ]; then
    . "$HOME/.deno/env"
fi

# macOS note. /etc/zprofile runs `path_helper`, which rebuilds PATH from
# /etc/paths and /etc/paths.d and moves anything already in PATH to the END.
# .zshenv runs before it, and on mac every terminal tab is a login shell, so in
# a terminal the prepends above come out *after* the system directories.
# Nothing is dropped, and nothing above needs to outrank /usr/bin today, so
# this is left as is. If something ever does, the fix is to clear the guard and
# re-source from .zshrc, which runs after path_helper.

# ------------------------------------------------------------
# Plain environment

# Where the private stash lives. Needed non-interactively, not just at a
# prompt: the restore_*/backup_* names on PATH are symlinks to
# private-dispatch.sh, which exits with an error when CONFPATH is unset -- and
# chezmoi runs restore_private.sh from .chezmoiscripts, with no interactive
# shell anywhere in sight. See restore_private.sh.
export CONFPATH="$HOME/Dropbox/configs"

export LC_ALL="en_US.UTF-8"

# use emacs as an editor everywhere
export VISUAL=emacs
export EDITOR="$VISUAL"

# Colour from BSD ls, the equivalent of always passing -G. Unconditional rather
# than mac-only: GNU ls ignores it and takes --color instead, which .bashrc
# arranges through dircolors.
#
# Safe in a file every shell reads -- per man ls, "colorization is silently
# disabled if the output is not directed to a terminal", so a pipe or a script
# sees no escapes. CLICOLOR_FORCE would defeat that and is deliberately unset.
#
export CLICOLOR=1

# Which colours is LSCOLORS: a positional string of foreground/background
# letter pairs, nothing like GNU's named LS_COLORS, so changing one entry means
# spelling out all twelve. This is BSD's own default with only the last pair
# altered.
#
# That last pair is slot 12, "dataless file" -- a cloud placeholder whose name
# is local but whose contents are not. Everything under ~/Dropbox is one until
# first opened, since it is a symlink into ~/Library/CloudStorage and goes
# through the File Provider framework. The default paints those `ah', black on
# light grey, which is a block of white background across half of
# `ls ~/Dropbox'.
#
# `hx' instead: light grey text, no background. Dimmer than a normal file,
# which reads as the right thing for one that is not really here, while staying
# perfectly legible. Measured against ghostty's defaults -- #282c34 background,
# #ffffff text -- light grey is palette 7, #c5c8c6, giving 8.3:1 against the
# background and 1.7:1 against normal text.
#
# Not `Ax', which was the first try: bold black is palette 8, #666666, only
# 2.4:1 on that background and so near invisible. Nor `Hx', which is legible
# but palette 15, #eaeaea, is 1.2:1 against #ffffff and so indistinguishable
# from an ordinary file -- no marker at all. `gx', cyan, is the option if a
# clearer distinction is ever wanted: 6.8:1 and 2.1:1, at the cost of a hue.
#
# Worth keeping some marker rather than turning it off with `xx'. A dataless
# file reads at network speed rather than disk speed, and it is why git inside
# Dropbox can report missing objects until the sync finishes -- `ls -G' on such
# a directory is the quickest way to see whether it is really there yet.
#
# Ignored on linux, where GNU ls reads LS_COLORS and dataless files do not
# exist.
export LSCOLORS=exfxcxdxbxegedabagacadhx

# always dump core, including from something started remotely. Not an
# environment variable, but inherited by children the same way, so it belongs
# with them. Silent on macOS, where the hard limit is already unlimited and
# only the soft one is 0.
ulimit -c unlimited

# Options for less. Here rather than in a shell's interactive half because
# less is mostly reached through something else -- git, man, brew -- including
# from scripts.
# https://www.topbug.net/blog/2016/09/27/make-gnu-less-more-powerful/
#
# --quit-if-one-screen (-F)  exit outright if it all fits on one screen.
# --ignore-case (-i)         case-insensitive search unless the pattern has a
#                            capital in it.
# --LONG-PROMPT (-M)         verbose prompt: line numbers and % through.
# --RAW-CONTROL-CHARS (-R)   pass colour escapes through to the terminal
#                            instead of showing them as ^[[31m, while still
#                            counting line lengths properly -- which plain -r
#                            does not.
# --HILITE-UNREAD (-W)       mark the first new line after a page down.
# --tabs=4                   postgres indents with 4.
# --window=-4                scroll four lines less than a full screen, so a
#                            page down keeps four lines of overlap.
# --mouse --wheel-lines=3    wheel scrolling, three lines at a time.
# --LINE-NUMBERS (-N)        line numbers down the left.
#
# All ten accepted by macOS's less, which is 668 and current; nothing here is
# GNU-only. --no-init (-X) is deliberately absent: it leaves less's output on
# the screen after quitting, and the warning that --quit-if-one-screen needs it
# does not hold in practice.
export LESS='--quit-if-one-screen --ignore-case --LONG-PROMPT --RAW-CONTROL-CHARS --HILITE-UNREAD --tabs=4 --window=-4 --mouse --wheel-lines=3 --LINE-NUMBERS'

# Colours for gcc's warnings and errors. Inert on macOS: cc and even
# /usr/bin/gcc there are clang, which has no GCC_COLORS equivalent -- it takes
# -fcolor-diagnostics and colours to a tty by default. Checked: the string does
# not appear in either Apple's clang or brew's llvm. Kept unconditionally for
# the linux side, where gcc is what builds postgres.
export GCC_COLORS='error=01;31:warning=01;35:note=01;36:caret=01;32:locus=01:quote=01'

# ------------------------------------------------------------
# Private half: secrets and machine-specific bits, not in this repo. It guards
# itself with an exported GLOBAL_VARS_LOADED and is re-read with the `gvr`
# alias. Note it now reaches zsh and a login dash too, which it did not when
# only .bashrc sourced it -- so it has to be POSIX as well.
if [ -f "$HOME/.global_vars" ]; then
    . "$HOME/.global_vars"
fi
