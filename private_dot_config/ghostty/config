# Ghostty. Mac-only, see .chezmoiignore.

# Safe to name unconditionally: where it is not installed ghostty falls
# back to the JetBrains Mono it bundles.
font-family = Ubuntu Mono

# Default is 13. Ubuntu Mono reads smaller than JetBrains Mono
# at the same size, so this may want another point or two. cmd+plus and
# cmd+minus adjust by one at runtime, so the way to retune is to find the size
# there and write the number here -- cmd+0 goes back to whatever this says.
font-size = 17

# Left option becomes Alt, so it sends ESC+key, which is what zsh and readline
# bind -- see .zshrc and .inputrc. Right option is left alone and still
# composes (c) and --, which is why this is "left" and not "true".
#
# This is half of the ergoemacs story in the terminal. The other half is in
# karabiner, which maps left cmd + letter to left option + letter for terminal
# apps, so the thumb means Meta here as it does in gui apps. It has to be
# karabiner and not keybinds in this file: ghostty's `super` is the cmd
# modifier on either side, with no left/right form -- left_super, super_left,
# physical:super and cmd_left are all rejected -- so keybinds here would take
# right cmd too, and right cmd is meant to stay the system's.
#
# Because only karabiner's fourteen letters move, and only on the left, every
# ghostty shortcut survives on the right thumb: right cmd + d still splits,
# + f still searches, + k still clears.
macos-option-as-alt = left

# Tabs on the thumb: left cmd + m goes left, left cmd + , goes right.
#
# Bound on alt rather than super for the same reason as everything else here --
# super would take right cmd too, and right cmd has to keep cmd+m minimise and
# cmd+, open_config. Karabiner turns left cmd + m into left option + m for
# terminal apps, option-as-alt above makes that alt+m, and this catches it.
#
# Taking alt+m and alt+, from the shell costs nothing: neither .inputrc nor
# .zshrc binds m or comma, by design -- they are left for the mac shortcuts.
# ctrl+tab and ctrl+shift+tab still switch tabs as they did.
keybind = alt+m=previous_tab
keybind = alt+comma=next_tab
