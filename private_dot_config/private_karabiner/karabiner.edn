;; ergoemacs, as goku would write it.
;;
;; NOT LIVE. karabiner.json beside this file is the config karabiner reads;
;; nothing generates it from here, and .chezmoiignore keeps this out of $HOME.
;; Kept for clarity, and so it has to be updated by hand when the json
;; changes. readme.txt says why it is kept; the rest of this header is what
;; to watch for if it is ever revived.
;;
;; Checked against the json by compiling it with goku, most recently on
;; 2026-11-27 with the screenshot rule in place: 16 rules and 44
;; manipulators on both sides, 35 identical and 9 differing only in how the app
;; conditions are grouped -- goku emits one condition per :applications entry
;; where the json merges the bundle ids into a single one. Karabiner ANDs
;; conditions, so unless(A or B) is the same as unless(A) and unless(B), and
;; the two are equivalent. Nothing differed. AGENTS.md has the procedure.
;;
;; Each of the last two runs was for one shape in particular, and settled it.
;; The window rule's two manipulators came back identical, so :f19 is a
;; to-side spelling goku accepts rather than one it drops without a word. The
;; screenshot rule's two did as well, so a key event and a shell command in
;; one to vector compile to the two-element "to" array they are meant to, with
;; the $HOME in the command passed through untouched.
;;
;; Modifier letters, from goku's tutorial.md:
;;   !  mandatory   #  optional
;;   C  left_command   T  left_control   O  left_option   S  left_shift
;;   Q  right_command  W  right_control  E  right_option  R  right_shift
;; So :!Cj is left cmd + j and :!Oleft_arrow is left option + left arrow.
;; The left/right split this scheme rests on is free here -- C is the left
;; command key only, never both, which is exactly what the json spells out
;; the long way with "left_command".
;;
;; The trap is the other side of that: S is left_shift, and there is no
;; letter for karabiner's plain "shift", which matches either key. Left cmd
;; is a left-thumb reach, so the shift actually pressed is usually the right
;; one -- :!CSh would have quietly stopped matching how these are typed. The
;; five shifted bindings therefore use the long form below. Note it is :key
;; and :modi, not :key_code and :modifiers; goku takes the karabiner spelling
;; without complaint and emits an empty "from", matching nothing.

{:profiles {:ergoemacs {:default true :delay 500}}

 ;; Named once, used by keyword below. In the json these four bundle ids are
 ;; repeated inside each of the twenty-six manipulators that need them.
 :applications {:emacs     ["^org\\.gnu\\.Emacs$"]
                :terminals ["^com\\.mitchellh\\.ghostty$"
                            "^com\\.googlecode\\.iterm2$"
                            "^com\\.apple\\.Terminal$"]
                :vscode    ["^com\\.microsoft\\.VSCode$"]
                ;; The terminals plus vscode, as one set rather than
                ;; [:terminals :vscode] in the rule below. goku emits one
                ;; condition per keyword and karabiner ANDs conditions, so two
                ;; frontmost_application_if conditions could never both hold
                ;; and the rule would never fire. The :!emacs :!terminals
                ;; vectors elsewhere get away with it only because
                ;; unless(A) and unless(B) is what unless(A or B) means.
                :tabapps   ["^com\\.mitchellh\\.ghostty$"
                            "^com\\.googlecode\\.iterm2$"
                            "^com\\.apple\\.Terminal$"
                            "^com\\.microsoft\\.VSCode$"]
                ;; Both browsers in one set rather than [:firefox :chrome] in
                ;; the rule, for the reason spelled out at :tabapps above.
                :browsers  ["^org\\.mozilla\\.firefox$"
                            "^com\\.google\\.Chrome$"]}

 :main
 [;; Real keys, so a TUI understands them. Everywhere but emacs, which does
  ;; the same split itself through ns-command-modifier -- terminals included,
  ;; which is the point: less, htop and fzf scroll on arrows and know nothing
  ;; of ESC+i, and Claude Code handles its prompt as raw key events.
  {:des "ergoemacs motion: left cmd + i/k/j/l arrows, u/o by word"
   :rules [[:!Ci :up_arrow         [:!emacs]]
           [:!Ck :down_arrow       [:!emacs]]
           [:!Cj :left_arrow       [:!emacs]]
           [:!Cl :right_arrow      [:!emacs]]
           [:!Cu :!Oleft_arrow     [:!emacs]]
           [:!Co :!Oright_arrow    [:!emacs]]]}

  ;; These four emit cmd+arrow, which cocoa and chromium honour and a tty
  ;; cannot encode at all -- hence the terminal exclusion, and hence h/H
  ;; reappearing as Home/End in the terminal rule below.
  ;; Shift variants first: a mandatory modifier set has to match exactly.
  {:des "ergoemacs line and buffer ends: left cmd + h/H, n/N"
   :rules [[{:key :h :modi {:mandatory [:left_command :shift]}} :!Cright_arrow   [:!emacs :!terminals]]
           [:!Ch  :!Cleft_arrow    [:!emacs :!terminals]]
           [{:key :n :modi {:mandatory [:left_command :shift]}} :!Cdown_arrow    [:!emacs :!terminals]]
           [:!Cn  :!Cup_arrow      [:!emacs :!terminals]]]}

  ;; Left key down, right key up. They were on c and v, which cost cmd+c and
  ;; cmd+v -- the strongest muscle memory on the machine -- and worse, made
  ;; them scroll, since what they emit is option+arrow. Digits are left to
  ;; applications on macOS; the one loss is a browser's cmd+1..9 tab jump.
  {:des "ergoemacs paragraphs: left cmd + 8 down, 9 up"
   :rules [[:!C9 :!Oup_arrow       [:!emacs :!terminals]]
           [:!C8 :!Odown_arrow     [:!emacs :!terminals]]]}

  ;; d, f and e reach terminals: backspace, delete and option+backspace are
  ;; real keys that zsh, readline and Claude Code all handle already. r is
  ;; left out -- option+delete reads as meta+delete, which Claude Code takes
  ;; as kill-to-end-of-line rather than kill-word.
  {:des "ergoemacs deletion: left cmd + d/f by char, e/r by word"
   :rules [[:!Cd :delete_or_backspace    [:!emacs]]
           [:!Cf :delete_forward         [:!emacs]]
           [:!Ce :!Odelete_or_backspace  [:!emacs]]
           [:!Cr :!Odelete_forward       [:!emacs :!terminals]]]}

  ;; g is ctrl+k, the one control key here that collides with nothing --
  ;; unlike ctrl+a, the tmux prefix. G is cmd+delete, which no tty can send.
  {:des "ergoemacs kill line: left cmd + g to end, G to start"
   :rules [[{:key :g :modi {:mandatory [:left_command :shift]}} :!Cdelete_or_backspace [:!emacs :!terminals]]
           [:!Cg  :!Tk                   [:!emacs]]]}

  ;; What is left of the old ESC+letter layer. It used to divert twelve
  ;; letters; the rest of the scheme now travels as real keys. Home and End
  ;; arrive as \eOH and \eOF, which zsh and Claude Code both already bind.
  ;; G and r stay on ESC+letter: they work in zsh and do nothing in Claude
  ;; Code, and their own rules above say why nothing better exists.
  {:des "ergoemacs in terminals: what is left of it"
   :rules [[{:key :h :modi {:mandatory [:left_command :shift]}} :end   :terminals]
           [:!Ch  :home  :terminals]
           [{:key :g :modi {:mandatory [:left_command :shift]}} :!OSg  :terminals]
           [:!Cr  :!Or   :terminals]]}

  ;; ghostty binds alt+m and alt+comma to previous_tab and next_tab. This has
  ;; to live here rather than in ghostty keybinds, because ghostty's super
  ;; modifier has no left/right form and right cmd must keep cmd+m minimise.
  {:des "tab switching in terminals and vscode"
   :rules [[:!Cm     :!Om     :tabapps]
           [:!Ccomma :!Ocomma :tabapps]]}

  ;; vscode's own gesture for moving a line is option+arrow, but the paragraph
  ;; rule above already emits that -- so left cmd + 9/8 moved code lines there,
  ;; and keybindings.json takes option+arrow for scrollPageUp/Down to stop it.
  ;; That leaves moveLines homeless, and this puts it back on the key it has on
  ;; linux. Letters, so option+shift+arrow and vscode's duplicate-line are left
  ;; alone. :!OSi is left_option + left_shift + i, matching the json; the from
  ;; side needs the long form because its shift is karabiner's plain "shift".
  {:des "move lines in vscode"
   :rules [[{:key :i :modi {:mandatory [:left_command :shift]}} :!OSi :vscode]
           [{:key :k :modi {:mandatory [:left_command :shift]}} :!OSk :vscode]]}

  ;; cmd+option+arrow is previous/next tab in firefox and in chrome alike.
  ;; Not ctrl+tab, which can be set to recently-used order rather than
  ;; positional.
  {:des "tab switching in browsers"
   :rules [[:!Cm     :!COleft_arrow  :browsers]
           [:!Ccomma :!COright_arrow :browsers]]}

  ;; Not scoped to any app. The terminal tab rule above emits exactly this
  ;; trigger and does not set it off: karabiner posts its output to the
  ;; virtual keyboard without feeding it back through the rules.
  {:des "left option + m switches apps"
   :rules [[:!Om :!Ctab]]}

  ;; Mission control's own shortcuts, which System Settings has enabled --
  ;; turn those off there and this goes quiet with nothing to show why.
  {:des "left option + u and i switch spaces"
   :rules [[:!Ou :!Tleft_arrow]
           [:!Oi :!Tright_arrow]]}

  ;; A crutch, and the crutch is macOS's. Its symbolic hotkey for this stores
  ;; a character beside the key code -- parameters = (character, keycode,
  ;; modifiers) -- and a russian layout stops the key below esc producing a
  ;; backtick, so the match fails. Why the command-layout fallback that keeps
  ;; cmd+c alive does not rescue it is unexplained and unreadable: the matcher
  ;; is compiled into the window server. This routes around rather than fixes.
  ;; karabiner matches the physical key by HID usage, below any layout, and
  ;; emits one with no character in any layout to get wrong.
  ;;
  ;; HALF OF IT. The other half is System Settings binding "Move focus to next
  ;; window" to cmd+F19, which bootstrap_mac.sh carries. Neither half says
  ;; anything when the other is missing. Set it by pressing cmd + ` into the
  ;; recorder -- this rule translates on the way in, and F19 cannot be typed.
  ;;
  ;; No goku letter for karabiner's plain command, which matches either key,
  ;; so the long form again -- the same gap as plain shift above. Either key
  ;; on purpose: the system hotkey leaves ` entirely, so right cmd + ` would
  ;; otherwise be dead rather than native. Shift reverses the cycle, which is
  ;; the system's doing, not this rule's.
  {:des "cmd + ` cycles windows within an app, by way of a phantom F19"
   :rules [[{:key :grave_accent_and_tilde :modi {:mandatory [:command :shift]}} :!CSf19]
           [{:key :grave_accent_and_tilde :modi {:mandatory [:command]}} :!Cf19]]}

  ;; A string in the to position is a shell command. One rule per app, so
  ;; each costs only that letter's composed character -- emacs is on r
  ;; rather than e to leave the dead keys alone. Absolute path because
  ;; karabiner runs shell_command with a bare environment. ChatGPT.app's
  ;; bundle id is com.openai.codex, not anything spelling out chat.
  {:des "app launchers on right option"
   :rules [[:!Ef "/usr/bin/open -b org.mozilla.firefox"]
           [:!Ec "/usr/bin/open -b com.google.Chrome"]
           [:!Ev "/usr/bin/open -b com.microsoft.VSCode"]
           [:!Eg "/usr/bin/open -b com.mitchellh.ghostty"]
           [:!Et "/usr/bin/open -b com.tdesktop.Telegram"]
           [:!Er "/usr/bin/open -b org.gnu.Emacs"]
           [:!Eh "/usr/bin/open -b com.openai.codex"]]}

  ;; macOS has no key for this any more -- every power-button combo Apple
  ;; documents is scoped to built-in keyboards WITHOUT touch id, and on this
  ;; one the power button is the touch id button, which locks instead. Right
  ;; option, beside the launchers, at the same cost: option+s composed an
  ;; eszett. karabiner makes the IOKit call itself, so no pmset and no shell.
  ;; Asymmetric in karabiner's own list: iokit_power_management_sleep_system
  ;; is to-only, while generic_desktop system_sleep is the sleep KEY and is
  ;; from-only, so it cannot be used here.
  ;;
  ;; :softf, and :sleep inside it, are goku's own names -- it renames :sleep
  ;; to iokit_power_management_sleep_system on the way out, the way :dbc
  ;; becomes cg_event_double_click. Spelled :software_function with the long
  ;; inner key, which is what karabiner itself wants, goku drops the lot and
  ;; emits "to": [{}], an empty action, saying nothing. Same failure as
  ;; :key_code below; the rule is that goku's name is never karabiner's.
  {:des "right option + s sleeps the machine"
   :rules [[:!Es {:softf {:sleep {}}}]]}

  ;; For leaving something running rather than suspending it; s above is the
  ;; one that sleeps. Two to events in a vector, which karabiner fires in
  ;; order on key down: ctrl+cmd+q locks, then pmset blanks the display.
  ;; The lock is a real key rather than a consequence of the screen going
  ;; dark, because dark only starts the idle path, which waits out the screen
  ;; lock delay -- 300 seconds here -- while ctrl+cmd+q locks immediately.
  ;; The delay is the point, not a precaution. Written the obvious way, both
  ;; as plain to events in one array, the screen blanked and woke again at
  ;; once: karabiner posts the sequence in microseconds, so the key-up for q
  ;; lands after pmset has started, and a key-up wakes a sleeping display.
  ;; to_if_invoked is cancelled if another key is pressed inside the window,
  ;; which after locking the screen is not a problem.
  ;;
  ;; goku puts the 500ms on the profile as :delay, where the json has it per
  ;; manipulator under parameters. Same number, wider blast radius: here it
  ;; would become the default to_delayed_action delay for every rule.
  {:des "right option + l locks and turns the screen off"
   :rules [[:!El :!TCq nil {:delayed {:invoked "/usr/bin/pmset displaysleepnow"}}]]}

  ;; macOS has both ends of this and not the middle: with the screenshot
  ;; destination set to the clipboard, the floating thumbnail that opens
  ;; Markup never appears, and its Done button saves a file rather than
  ;; copying. The script is the middle -- clipboard to a temp file, Preview
  ;; for the drawing, back to the clipboard on save -- and its header has the
  ;; rest. The 4 binding presses shift+cmd+4 rather than calling screencapture
  ;; itself, which leaves the Screen Recording grant with the system.
  ;;
  ;; Two to events in one vector, as the lock rule above tried and could not
  ;; use. Harmless here: karabiner posts them microseconds apart, and the
  ;; script's first act is to wait for the clipboard to change.
  ;;
  ;; The script's other mode -- annotate an image already on the clipboard,
  ;; the same thing without the capture -- is left unbound on purpose: right
  ;; option + a is wanted for Claude desktop.
  {:des "right option + 3 and 4 capture the screen or a region, and annotate it"
   :rules [[:!E3 [:!CS3 "$HOME/.bash_scripts/bin/annotate_clipboard.sh --wait"]]
           [:!E4 [:!CS4 "$HOME/.bash_scripts/bin/annotate_clipboard.sh --wait"]]]}]}
