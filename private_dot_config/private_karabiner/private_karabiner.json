                                        "modifiers": ["left_control"]
                                    }
                                ],
                                "type": "basic"
                            }
                        ]
                    },
                    {
                        "description": "ergoemacs in terminals: what is left of it. This rule used to divert twelve letters to left option + letter, so ghostty's macos-option-as-alt=left would turn them into the ESC+letter sequences zsh and readline bind. The rest of the scheme now uses the real keys instead -- arrows, option+arrows, backspace, delete, option+backspace, ctrl+k -- because those are what a TUI reads, and zsh, readline and Claude Code already agree on all of them. Four cases remain. h and H become Home and End: the native line-end combo is cmd+arrow, which no terminal can send, while Home and End arrive as \\eOH and \\eOF, which zsh binds to beginning-of-line and end-of-line already and which Claude Code's input reads as home and end. G and r stay on ESC+letter, which works in zsh and does nothing in Claude Code; their own rules say why nothing better exists. Left cmd only, as everywhere here, so right cmd keeps every terminal shortcut. This has to live here rather than in ghostty keybinds, because ghostty's super modifier has no left/right form.",
                        "manipulators": [
                            {
                                "conditions": [
                                    {
                                        "bundle_identifiers": [
                                            "^com\\.mitchellh\\.ghostty$",
                                            "^com\\.googlecode\\.iterm2$",
                                            "^com\\.apple\\.Terminal$"
                                        ],
                                        "type": "frontmost_application_if"
                                    }
                                ],
                                "from": {
                                    "key_code": "h",
                                    "modifiers": { "mandatory": ["left_command", "shift"] }
                                },
                                "to": [{ "key_code": "end" }],
                                "type": "basic"
                            },
