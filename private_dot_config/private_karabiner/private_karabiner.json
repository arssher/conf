                                    {
                                        "bundle_identifiers": ["^org\\.gnu\\.Emacs$"],
                                        "type": "frontmost_application_unless"
                                    }
                                ],
                                "from": {
                                    "key_code": "d",
                                    "modifiers": { "mandatory": ["left_command"] }
                                },
                                "to": [{ "key_code": "delete_or_backspace" }],
                                "type": "basic"
                            },
