# Patterns here are TARGET paths -- where a file would land relative to $HOME --
# not source paths. So the script archive is ".bash_scripts/archive" (its
# destination), even though it lives at dot_bash_scripts/archive/ in the source.
# Writing "dot_bash_scripts/archive" would match nothing and the archive would
# get applied into ~/.bash_scripts/archive.

# Repo-only content: the readme, the bootstrap scripts, and the vscode settings
# backup (kept in git for paranoia; vscode normally syncs via the GH account).
readme.txt
bootstrap.sh
bootstrap.yml
vscode

# Scripts parked for review. Tracked in git, never applied to $HOME.
.bash_scripts/archive
.bash_scripts/archive/**

# Keyboard-diagram generator. Repo-only: it is a tool that reads the applied
# ~/.emacs.d/init.el, not config that ~/.emacs.d needs. Run it from the source
# tree. Its generated .svg/.png are gitignored.
.emacs.d/kbd-diagram
.emacs.d/kbd-diagram/**

# Machine-local Claude Code permission overrides. Only this file: the rest of
# dot_claude/ is managed. Never add ~/.claude/.credentials.json or the state
# under projects/, sessions/, history.jsonl and friends -- this repo is public.
.claude/settings.local.json

# Stashes kept outside this repo. They are gitignored, but chezmoi reads the
# filesystem rather than git, so without these lines `chezmoi apply` copies them
# into ~/private/ and ~/etc/, where nothing reads them.
# restore_private.sh is what puts their content in the right places.
private
private/**
etc
etc/**

# Linux-only targets, skipped on macOS. This file is always treated as a
# template, so no .tmpl suffix -- adding one would stop it being read at all.
# .xbindkeysrc is X11; terminator is a Linux GTK terminal; environment.d is a
# systemd user-session mechanism and macOS has no systemd.
# Not excluded on purpose: dot_gdbinit/dot_gdb/ (gdb installs via brew, and the
# content is postgres pretty-printers), and the xbindkeys hook, which already
# self-guards on `command -v xbindkeys`.
{{ if eq .chezmoi.os "darwin" }}
.xbindkeysrc
.config/terminator
.config/environment.d
{{ end }}
