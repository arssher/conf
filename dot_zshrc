# zsh, the login shell on macOS. Interactive settings only: the environment
# arrives from ~/.sh_env via ~/.zshenv, which bash reads too, so the two shells
# cannot drift apart. Nothing to source here -- .zshenv has already run by the
# time this file does.

# emacs keymap, the same as .inputrc's `set editing-mode emacs`. Say it
# explicitly: zsh picks the keymap from $EDITOR otherwise, and would land in
# vi mode the moment that says vi.
bindkey -e

# Ergoemacs motion, the zsh half of .inputrc. The two files have to agree,
# since one serves bash and the other zsh and the fingers do not know which
# shell they are in. readme.txt lists the places this layout lives.
#
# The sequences are ESC+letter, because that is all a terminal can deliver --
# cmd is never transmitted to the tty at all. Two things conspire to produce
# them from the thumb, so it works here as it does in gui apps: karabiner maps
# left cmd + letter to left option + letter in terminal apps, and ghostty's
# macos-option-as-alt=left turns left option into ESC. It takes karabiner for
# the first half because ghostty's cmd modifier has no left/right form, and
# right cmd has to stay the system's.
bindkey '\ee' backward-kill-word
bindkey '\er' kill-word
bindkey '\eu' backward-word
bindkey '\eo' forward-word
bindkey '\ed' backward-delete-char
bindkey '\ef' delete-char
bindkey '\eg' kill-line
bindkey '\eG' backward-kill-line
bindkey '\eh' beginning-of-line
bindkey '\eH' end-of-line
bindkey '\ej' backward-char
bindkey '\el' forward-char

# i and k are previous-history/next-history in .inputrc. zsh has those under
# the same names, but the -line-or- variants move inside a multi-line buffer
# first and only reach for history at its edges, which is what the binding
# means to do.
bindkey '\ei' up-line-or-history
bindkey '\ek' down-line-or-history

# Still missing, compared with what .bashrc does for bash: history settings,
