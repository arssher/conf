# zsh, the login shell on macOS. Interactive settings only: the public
# environment arrives from ~/.sh_env via ~/.zshenv, which bash reads too, so
# the two shells cannot drift apart. .zshenv has already run by the time this
# file does.
#
# The one thing sourced here is the private half, ~/.global_vars, below. It is
# kept out of .sh_env because ~/.profile reads that, /etc/gdm3/Xsession sources
# ~/.profile, and gnome-session imports the result into `systemd --user` -- so
# .sh_env reaches gnome-shell and every GUI app, and the tokens in
# .global_vars have no business being there. An interactive rc file is never on
# that route. See ~/.profile's header.
#
# Guards itself with an exported GLOBAL_VARS_LOADED, so a nested shell reads it
# once. source_env, defined in .sh_env, re-reads both after an edit.
if [ -f ~/.global_vars ]; then
    source ~/.global_vars
fi

# Re-read this file after editing it. Everything below is idempotent --
# setopt, bindkey and alias all just overwrite -- so a second pass is safe.
#
# It does NOT re-read ~/.sh_env: that guards itself with an exported
# SH_ENV_LOADED and is already set by the time any shell gets here. Use
# source_env, defined there, for the environment. Nor does it undo anything --
# a binding or option deleted from the file stays in effect until a new shell.
alias shrc='source ~/.zshrc'

# emacs keymap, the same as .inputrc's `set editing-mode emacs`. Say it
# explicitly: zsh picks the keymap from $EDITOR otherwise, and would land in
# vi mode the moment that says vi.
bindkey -e

# Ergoemacs motion, the zsh half of .inputrc. The two files have to agree,
# since one serves bash and the other zsh and the fingers do not know which
# shell they are in.
#
# The sequences are ESC+letter, which is how the gesture arrives on linux,
# where Alt is Meta and the keyboard sends it directly. On mac it takes two
# steps -- karabiner turns left cmd + letter into left option + letter, and
# ghostty's macos-option-as-alt=left turns left option into ESC -- and karabiner
# is needed for the first step because ghostty's cmd modifier has no left/right
# form, while right cmd has to stay the system's.
#
# Most of the mac half no longer comes through here, though: karabiner now
# sends the real keys instead, so that TUIs understand them too. See the
# arrow-sequence block further down, and the karabiner rules for the reasoning.
# These stay for linux, and are harmless on mac -- nothing emits them.
bindkey '\ee' backward-kill-word
bindkey '\er' kill-word
bindkey '\eu' backward-word
bindkey '\eo' forward-word
bindkey '\ed' backward-delete-char
bindkey '\ef' delete-char
bindkey '\eg' kill-line
bindkey '\eG' backward-kill-line
bindkey '\eh' beginning-of-line
bindkey '\eH' end-of-line
bindkey '\ej' backward-char
bindkey '\el' forward-char

# What counts as a word, for every widget above that takes one. zsh's default
# is $WORDCHARS = *?_-.[]~=/&;!#$%^(){}<>, and a slash being in there makes a
# whole path one word: on `cd /usr/local/share/foo' with the cursor at the end,
# M-e killed back to `cd ' and M-u jumped the entire path in one go. readline
# has never behaved that way -- its backward-word is "letters and digits",
# full stop -- and .inputrc serves the same gestures in bash, so the two have
# to agree.
#
# select-word-style rather than assigning WORDCHARS by hand: it sets a zstyle
# and swaps the standard widgets for the contributed *-match versions, so one
# setting covers every word widget and the per-widget overrides below become
# possible. `bash' is its name for alphanumerics-only. Measured on the line
# above, cursor at the end:
#   default:  backward-kill-word -> [cd ]
#   bash:     backward-kill-word -> [cd /usr/local/share/]
autoload -Uz select-word-style
select-word-style bash

# ^W kept on whitespace, which is what it was doing before this and what it
# does in bash -- readline has it on unix-word-rubout, not backward-kill-word,
# so it takes the whole path and ignores the alnum rule. zsh binds ^W to plain
# backward-kill-word, which the line above would otherwise narrow along with
# everything else. A separate widget because the word style is read from the
# zstyle context `:zle:$WIDGET', so a binding needs its own name to carry its
# own style; `-match' is the contributed widget select-word-style autoloads.
zle -N ws-backward-kill-word backward-kill-word-match
zstyle ':zle:ws-backward-kill-word' word-style whitespace
bindkey '^W' ws-backward-kill-word

# Option+arrow, for the word motion that left cmd + u/o now emits on mac.
# Backspace, delete, option+backspace and ctrl+k are bound out of the box to
# exactly the widget the gesture wants, which is what made moving to real keys
# cheap. Option+arrow, the plain arrows and Home/End each need a line here, for
# reasons that differ: nothing binds option+arrow at all, the arrows are bound
# to a weaker widget than the gesture means, and Home/End are bound only in a
# form that never arrives -- see the blocks below.
#
# The CSI form is what ghostty is configured to send -- see its config, which
# has to override a default of alt+arrow_right=esc:f, a sequence this file
# binds to delete-char a few lines up. That file also decodes the 1;3.
bindkey '\e[1;3D' backward-word
bindkey '\e[1;3C' forward-word

# The same keystroke spelled the older way. There are two encodings for
# alt+<key>, and which one arrives is a terminal setting:
#
#   prefix style, "Option as Meta"   \e\e[D     Terminal.app, iTerm
#   parameter style, xterm's         \e[1;3D    most modern emulators
#
# The prefix style is only the Meta convention applied to a key that is
# already an escape sequence: to send a key with Meta held, put ESC in front
# of what it sends alone. An arrow alone is \e[D, so alt+arrow is ESC then
# \e[D. There is nothing special about the doubling -- the first ESC is the
# Meta flag, the second belongs to the arrow's own \e[ opener. The same rule
# gives \e\e[3~ for alt+delete and \e\177 for alt+backspace, that last being
# what left cmd + e rides, and the reason option+backspace kills a word where
# a bare backspace kills a character.
#
# Bound alongside the CSI form so the gesture survives a terminal other than
# ghostty. Keeping both is free: zle's keymap is a trie over byte sequences,
# so \e[D and \e\e[D are just different paths through it and cannot collide.
# The one cost is that ESC ESC becomes a prefix, so a bare double-Escape now
# waits out KEYTIMEOUT -- 0.4s -- for a third byte. Nothing here binds \e\e,
# so that pause is the whole of it.
bindkey '\e\e[D' backward-word
bindkey '\e\e[C' forward-word

# Ctrl+arrow, which is what left alt + u/o emits on linux: xremap sends the
# GTK word-motion keys there, ctrl rather than option, as Claude Code ignores
# alt+arrows. bash has these from /etc/inputrc; zsh reads no inputrc and binds
# nothing to them, so without these lines u/o did nothing at all. Modified
# keys keep the CSI form even with the keypad in application mode.
bindkey '\e[1;5D' backward-word
bindkey '\e[1;5C' forward-word

# i and k are missing from this list on purpose: they move through history, so
# they are bound at the end of the history section below, where the widget they
# need can be loaded first.

# ------------------------------------------------------------
# History.
#
# Not a copy of .bashrc's: zsh does natively most of what that file works
# around with PROMPT_COMMAND and shopt, so only the options that earn their
# place are here. Its own file -- EXTENDED_HISTORY's format is not bash's, so
# the two cannot share one. Nothing is exported: this is per-shell state, which
# is why it lives here and not in .sh_env.
HISTFILE=~/.zsh_history
# In memory, and in the file. No unlimited form exists in zsh, so: a big
# number. The file is rewritten to trim itself once it is 20% past SAVEHIST.
#
# HISTSIZE being this large has one known cost: zsh-autosuggestions globs the
# whole in-memory list for every lookup, which at a million entries measures
# 35ms. The note by ZSH_AUTOSUGGEST_STRATEGY at the end of this file says what
# to do about it, and it is not shrinking this number.
HISTSIZE=1000000
SAVEHIST=1000000

# All shells share one history, live: this both imports other shells' lines and
# appends ours as they are typed. Deliberately different from bash here, where
# each terminal keeps its own. It supersedes INC_APPEND_HISTORY and
# INC_APPEND_HISTORY_TIME -- the three are mutually exclusive -- and makes
# .bashrc's `history -a` in PROMPT_COMMAND unnecessary.
setopt SHARE_HISTORY

# Timestamp and duration per entry, as `: <start>:<elapsed>;<command>'. Read
# them back with `fc -l -d` or `-f`; plain `history` hides them, as bash's does
# without HISTTIMEFORMAT. SHARE_HISTORY turns this on regardless, so saying it
# explicitly only documents the file format.
setopt EXTENDED_HISTORY

# A leading space keeps a command out of history -- for anything with a secret
# in the argv. The line still lingers in the current shell until the next
# command, so it can be edited and reused first.
setopt HIST_IGNORE_SPACE
# Don't record a line identical to the one just before it.
setopt HIST_IGNORE_DUPS
# Strip superfluous whitespace before storing.
setopt HIST_REDUCE_BLANKS
# Don't record `history`/`fc -l` itself.
setopt HIST_NO_STORE

# Hide repeats while cycling or searching -- but only while showing them.
# Nothing here removes a duplicate from the history list or from the file, and
# that is the deliberate difference from .bashrc's HISTCONTROL=erasedups:
# erasing duplicates loses when a command ran the other times, and with a
# million entries there is no reason to pay that.
#
# Not HIST_SAVE_NO_DUPS either, which would omit older duplicates when the file
# is written. It is the only thing that would make this file a lossy record,
# and the file being complete is what lets history-merge.py read it instead of
# a hook writing every command out twice -- see the note where that hook would
# have gone.
setopt HIST_FIND_NO_DUPS

# Expand `!!` and `!$` into the buffer for inspection instead of running them
# straight away.
setopt HIST_VERIFY

# fcntl locking on the history file. With one shared file and many terminals
# writing to it after every command, this is what stops it being corrupted.
setopt HIST_FCNTL_LOCK

# No beep when a history movement hits either end.
unsetopt HIST_BEEP

# History with readable timestamps. zsh has no HISTTIMEFORMAT: `history' is
# just `fc -l', and the format lives on the flag -- so the date has to be asked
# for every time, hence the alias. [%F %T] is strftime, and matches the
# HISTTIMEFORMAT .bashrc uses, so the two shells print alike.
#
# No range in the alias on purpose, so arguments still work: `h' alone gives
# fc's default of the last 16, `h -50' the last 50, `h 1' everything, `h make'
# from the last command starting with make.
#
# Not -D, which would add each command's duration: EXTENDED_HISTORY has a field
# for it, but SHARE_HISTORY appends the line as soon as it is typed -- before
# the command runs -- so the field is always 0:00. Tested with `sleep 2'. Only
# INC_APPEND_HISTORY_TIME writes after the command finishes and records it, and
# that one cannot be combined with sharing. Durations or shared history, not
# both; sharing is worth more.
alias h='fc -l -t "[%F %T]"'

# i and k, the two ergoemacs bindings that belong with history rather than with
# the motion keys above.
#
# up-line-or-beginning-search moves within a multi-line buffer first, and at
# its edge searches history for entries beginning with everything left of the
# cursor, leaving the cursor at the end of the line. So typing `git com' and
# then M-i walks only the git com... commands, and consecutive presses keep
# that same prefix. Compare up-line-or-history, which ignores what is typed,
# and up-line-or-search, which matches on the first word only.
#
# .inputrc has the readline equivalent, history-search-backward/-forward, so
# the two agree. readline has no up-line-or- compound, so its version searches
# unconditionally rather than walking a multi-line buffer first; for
# single-line commands they behave the same.
#
# Contributed widgets, so they need autoloading and registering with zle -N
# before bindkey will accept the names.
autoload -Uz up-line-or-beginning-search down-line-or-beginning-search
zle -N up-line-or-beginning-search
zle -N down-line-or-beginning-search
bindkey '\ei' up-line-or-beginning-search
bindkey '\ek' down-line-or-beginning-search

# The bare arrows get the same widget. On mac, karabiner sends left cmd + i/k
# as a real up/down arrow in a terminal rather than as ESC+i -- a TUI reads
# arrows and knows nothing of ESC+i -- so without this the M-i gesture would
# quietly downgrade to whatever the arrows do, and in a terminal the ESC
# sequences above are no longer reachable at all. The same on linux, where
# xremap sends left alt + i/k as the arrows.
#
# Which form arrives depends on the system zshrc, so both are bound. An arrow
# sends \e[A in the terminal's normal mode and \eOA in application mode, which
# a program turns on by printing terminfo's smkx; terminfo's key table, kcuu1 =
# \eOA, describes application mode.
#
#   mac: zle never emits smkx -- checked by capturing an interactive zsh
#   through a pty, which sends \e[?2004h for bracketed paste and no
#   \e[?1h\e= -- so \e[A arrives. /etc/zshrc's ${key[Up]} binding is the \eOA
#   form and never fires, and the arrows stay on zsh's built-in
#   up-line-or-history until overridden here.
#
#   debian: /etc/zsh/zshrc defines zle-line-init to print smkx, and
#   zle-line-finish rmkx, "only then are the values from $terminfo valid".
#   So while a line is being edited \eOA arrives, and \e[A is the one that
#   never does.
bindkey '\e[A' up-line-or-beginning-search
bindkey '\e[B' down-line-or-beginning-search
bindkey '\eOA' up-line-or-beginning-search
bindkey '\eOB' down-line-or-beginning-search

# Home and End, which left cmd + h/H send in a terminal, and the same split
# bites harder: the arrows at least did something without the lines above,
# where these did nothing at all.
#
# /etc/zshrc binds ${key[Home]} and ${key[End]}, which are terminfo khome and
# kend -- \eOH and \eOF for xterm-ghostty. Those are the application-mode
# forms, so on mac, by the same smkx argument as the arrows, they never arrive;
# what does arrive is \e[H and \e[F, and `bindkey '^[[H'` answered
# undefined-key. Hence left cmd + h in ghostty moving the cursor nowhere. On
# debian it is the other way round again, \eOH and \eOF arriving, so all four
# are bound.
#
# readline has no such gap -- it ships all four, which is why .inputrc needs
# nothing and the breakage looked zsh-specific:
#   beginning-of-line can be invoked via "\C-a", "\eOH", "\e[H", "\eh".
bindkey '\e[H' beginning-of-line
bindkey '\e[F' end-of-line
bindkey '\eOH' beginning-of-line
bindkey '\eOF' end-of-line

# There is deliberately no hook feeding ~/.persistent_history from here, the
# way .bashrc does from PROMPT_COMMAND. history-merge.py reads this file
# directly when the backup runs, so a hook would only duplicate the work -- and
# worse, it would have to re-implement HIST_IGNORE_SPACE by hand to avoid
# writing out the commands that very option exists to keep out. Reading the
# file inherits that and HIST_IGNORE_DUPS, HIST_NO_STORE and
# HIST_REDUCE_BLANKS for nothing.
#
# bash still needs its hook, because HISTCONTROL=erasedups strips older
# duplicates from its history file on every write, so the file alone cannot say
# when a repeated command ran before. Nothing here does that to this file --
# see the note on HIST_SAVE_NO_DUPS above -- so it is a complete record.

# ------------------------------------------------------------
# Completion.
#
# compsys, zsh's own completion system. compinit scans every fpath directory
# for files named _* -- _git, _brew, _ssh -- works out which command each one
# completes, and caches the answer in ~/.zcompdump. Without it Tab does bare
# filename completion and nothing more.
#
# That scan is slow, so it runs at most once in 24 hours: every other shell
# loads the dump as it stands. The consequence is that a newly installed
# command's completion can take a day to appear -- delete ~/.zcompdump to have
# it picked up now.

# Homebrew keeps its completions in its own prefix, which is not on the default
# fpath: `brew shellenv' would add it, and that is deliberately not run here.
# Has to come before compinit, which reads fpath once. Guarded, so linux skips
# it -- as do intel macs, where the brew prefix is /usr/local and its
# site-functions is on fpath already.
if [[ -d /opt/homebrew/share/zsh/site-functions ]]; then
    fpath=(/opt/homebrew/share/zsh/site-functions $fpath)
fi

# zsh/complist implements the completion menu that `menu select' below asks
# for. It would be autoloaded on first use anyway, but then its menuselect
# keymap does not exist at startup and cannot be bound -- bindkey says "no such
# keymap". Loading it here, before compinit as the manual advises, is what
# makes the bindings at the end of this section possible.
zmodload zsh/complist

autoload -Uz compinit

# -C is what skips the scan, along with the insecure-directory check. Measured
# here, warm: 23ms per interactive shell for the full run against 14ms with -C.
# Cold, with nothing cached and no dump yet, the full run took 150ms.
#
# An array assignment rather than the usual `[[ -n ~/.zcompdump(#qN.mh+24) ]]':
# [[ ]] performs no filename generation, so that test is always true and always
# rebuilds. Plain qualifiers too, since (#q...) needs EXTENDED_GLOB. (N) yields
# nothing instead of an error when the file is absent and (mh-24) matches only
# if it was modified within the last 24 hours, so a missing dump and a stale one
# both fall through to the full run.
_zcompdump_fresh=(~/.zcompdump(Nmh-24))
if (( $#_zcompdump_fresh )); then
    compinit -C
else
    compinit
fi
unset _zcompdump_fresh

# zstyle is zsh's general settings lookup, not a completion thing: a value is
# stored against a context pattern and whoever cares looks it up. Completion
# contexts read
# :completion:<function>:<completer>:<command>:<argument>:<tag>, matched
# coarsely with ':completion:*' below except where a specific command is meant.

# An arrow-key menu instead of a static list. Per the manual, a value
# containing `select' starts menu selection unconditionally; it is the
# zsh/complist module that implements it, and compinit loads that.
zstyle ':completion:*' menu select

# Case-insensitive as a fallback rather than as the rule. The empty first
# element makes zsh try an exact match first and only retry with the m:
# specification if that found nothing, so an exact hit is never buried among
# case-variants. Then dow<TAB> still finds Downloads.
zstyle ':completion:*' matcher-list '' 'm:{a-zA-Z}={A-Za-z}'

# Group matches by what they are -- options, files, branches -- rather than one
# flat list. group-name '' names each group after its tag, and format is what
# actually prints the heading: on its own group-name only groups silently. %d
# is the tag's description, and the colour escapes are the ones compadd -X
# takes.
zstyle ':completion:*' group-name ''
zstyle ':completion:*:descriptions' format '%F{yellow}-- %d --%f'

# Colour the list by file type: directories, symlinks, executables, devices.
# Needs neither LS_COLORS nor GNU coreutils, which this machine has not got --
# the ${(s.:.)LS_COLORS} form everyone copies is only for reusing a scheme of
# one's own.
#
# It applies wherever filenames are completed, not just to ls -- cat, vim, cp,
# git add. Matches that are not files fall under the `no' capability, which
# defaults to 0, so git subcommands, option flags and the kill listing stay
# plain; colouring those would take =pattern= specifications, the one form that
# matches any display string rather than only filenames.
#
# di=1;34 because the built-in default for directories is 1;31, bold red, which
# shouts and reads like an error. zshmodules(1) claims the default is 32; it is
# not, checked by capturing a real completion list through a pty -- an empty
# value gave ^[[1;31m. 1;34 is bold blue, which is what GNU ls uses and so what
# the linux side of this repo already shows. Anything left unspecified keeps
# its own default, also checked: executables stayed 1;32.
zstyle ':completion:*:default' list-colors 'di=1;34'

# Offer . and .. , which zsh otherwise never does.
zstyle ':completion:*' special-dirs true

# Treat foo//bar as foo/bar -- "the usual behaviour of UNIX paths", says the
# manual; by default file completion acts as if there were a * between them.
zstyle ':completion:*' squeeze-slashes true

# Rehash before completing an external command, so something brew has just
# installed is offered without a manual `rehash'. The documented cost is a
# slower search when a directory on PATH has slow file access.
zstyle ':completion:*' rehash true

# Cache the completions that are expensive to compute, brew's among them.
# cache-path needs no setting: it already defaults to ~/.zcompcache.
zstyle ':completion:*' use-cache on

# kill <TAB> with enough columns to tell the processes apart.
#
# POSIX keyword names throughout. The usual form of this line asks for `cmd',
# which is GNU ps; BSD ps does not know it, drops the column and carries on, so
# the listing arrives with no command in it at all -- and _pids runs ps with
# stderr sent to /dev/null, so `ps: cmd: keyword not found' never reaches the
# screen. args is the portable spelling, likewise pcpu for %cpu, time for
# cputime.
#
# Matched on the processes tag rather than on kill, so pkill, renice and wait
# get the same listing. Note `ps <TAB>' does not use it: that completes ps's
# own options, and only `ps -p <TAB>' reaches the tag.
zstyle ':completion:*:processes' \
    command 'ps -u $USER -o pid,pcpu,tty,time,args'

# Menu selection runs in its own keymap, so the ergoemacs motion bound in main
# does not reach it and the menu would be arrow-keys-only. Same four letters as
# above: j and l move within a row, i and k between rows.
bindkey -M menuselect '\ej' backward-char
bindkey -M menuselect '\el' forward-char
bindkey -M menuselect '\ei' up-line-or-history
bindkey -M menuselect '\ek' down-line-or-history

# ------------------------------------------------------------
# Prompt.
#
# Same shape and colours as .bashrc's PS1, so the two shells look alike: bold
# green user@host, bold blue full path, then the prompt character.
#
# %n user, %m host up to the first dot (\u and \h), %~ the path with $HOME as
# ~ (\w), %# the prompt character, % for a normal user and # for root (\$).
#
# The colour is guarded because zsh only half-degrades: on a terminal with no
# colour it drops %B, but still emits the %F escape, so TERM=dumb would get
# literal control codes. terminfo[colors] is unset there and 256 in a real
# terminal. .bashrc makes the same check with `tput setaf 1'.
zmodload zsh/terminfo
if (( ${terminfo[colors]:-0} >= 8 )); then
    PROMPT='%B%F{green}%n@%m%f %F{blue}%~ %#%f%b '
else
    PROMPT='%n@%m %~ %# '
fi

# ------------------------------------------------------------
# fzf: an interactive filter. On its own it reads lines on stdin, narrows them
# as a query is typed and prints the one picked -- `ls | fzf', `git branch |
# fzf'. What earns it a place in this file is the shell integration: three ZLE
# widgets, each replacing a search that could only ever show one candidate at
# a time.
#
# ^R displaces history-incremental-search-backward. It feeds the whole history
# through fzf, deduplicated, takes whatever is already on the line as the
# initial query, and puts the chosen entry in the buffer WITHOUT running it --
# the same contract HIST_VERIFY above asks for. ^R again inside fzf toggles
# sort between relevance and recency, and it runs --multi, so several lines can
# be picked and come back newline-joined. Next to `h' further up: fc prints a
# list to read, this hands back a line to edit.
#
# ^T inserts the picked paths at the cursor, shell-quoted, displacing
# transpose-chars. M-c cd's into a picked directory and is the one that does
# not wait -- it calls accept-line itself, so the cd happens on selection.
# Neither key is claimed above: the ESC+letter set in this file stops at
# e r u o d f g G h H i j k l, and ^T was never bound. To drop one, set
# FZF_CTRL_T_COMMAND= or FZF_ALT_C_COMMAND= to empty ON the eval line below --
# the scripts read them as they load, so assigning afterwards does nothing.
#
# Fuzzy completion arrives in the same breath and rebinds ^I. Harmless:
# fzf-completion only acts when the word ends in `**' (FZF_COMPLETION_TRIGGER)
# and otherwise calls the widget it displaced, which it reads out of
# `bindkey "^I"' as it loads -- so compinit and the menuselect keymap bound
# further up keep behaving as before. The gesture is `vim **<TAB>'.
#
# Sourced before the two plugins below rather than after, because
# zsh-syntax-highlighting asks to be the last thing in the file.
#
# One cost to know, and it is the HISTSIZE one again. ^R builds its list by
# printing the in-memory $history array and deduplicating it through perl, on
# every press. Measured here with unique entries: 7ms at ten thousand, 67ms at
# a hundred thousand, 772ms at a million. At the eighty-odd thousand this
# history holds today that is about 60ms and unnoticeable; at the million
# HISTSIZE allows, ^R would sit for the better part of a second before fzf drew
# anything. The answer then is to narrow what the widget is fed, not to shrink
# the history -- the same trade as the autosuggestions note below.
#
# `fzf --zsh' prints both scripts out of the binary, which is the supported
# route and cannot drift from the version installed. It wants fzf 0.48 (Feb
# 2024): brew's is 0.74 and trixie's 0.60.3, but bookworm ships 0.38.0, which
# has no such flag -- hence the fallback to the files the debian package leaves
# under /usr/share/doc. stdin is closed on the probe so that a version which
# did not recognise the flag could not sit waiting for input at startup.
#
# One cosmetic wart. The scripts save the whole option set as they start and
# restore it as they finish, and restoring `zle' fails where there is no
# terminal -- so `zsh -ic ...' from a script now prints "can't change option:
# zle" twice on stderr. Under a real terminal it is silent, and `[[ -o zle ]]'
# is no help: that reads on in both. Wrapping the block in `[[ -t 0 ]]' would
# stop it, at the price of skipping fzf wherever zsh is talked to over a pipe.
if (( $+commands[fzf] )); then
    if _f=$(fzf --zsh 2>/dev/null </dev/null); then
        eval "$_f"
    else
        for _f in /usr/share/doc/fzf/examples/key-bindings.zsh \
                  /usr/share/doc/fzf/examples/completion.zsh; do
            [[ -r $_f ]] && source $_f
        done
    fi
    unset _f
fi

# ------------------------------------------------------------
# zsh-autosuggestions: while typing, the rest of a matching history line is
# shown in grey ahead of the cursor. From zsh-users, and nothing to do with
# oh-my-zsh, which is only where most people meet it.
#
# Last in the file by convention rather than necessity. It works by wrapping
# ZLE widgets, but it does that from a precmd hook and by default repeats it on
# every precmd -- deliberately, so it can wrap other wrappers, which is what
# keeps it compatible with zsh-syntax-highlighting -- so widgets defined
# anywhere in this file get picked up either way.
# ZSH_AUTOSUGGEST_MANUAL_REBIND makes the wrapping happen once, which the
# source says costs "a decent performance hit" less, at the price of the order
# then mattering. Async fetching is on by itself: the plugin enables it for zsh
# 5.0.8 and newer.
#
# Acceptance is bound by widget rather than by key, so it lands on the
# ergoemacs bindings for nothing: ACCEPT_WIDGETS holds forward-char and
# end-of-line, so M-l and M-H take the whole suggestion, and
# PARTIAL_ACCEPT_WIDGETS holds forward-word, so M-o takes a word of it. A full
# accept fires only with the cursor at the end of the line; anywhere else the
# original widget runs instead, so M-l still just moves right.

# Suggestions come from history first and then from what completion would
# offer, so a flag or a path never typed before is still suggested. Each
# strategy is tried in turn until one answers.
#
# The completion one is the expensive strategy: it forks a pseudo-terminal per
# lookup and needs both compdef and the zsh/zpty module -- the first because
# compinit runs further up this file, the second because zpty ships with zsh.
# It only runs when history has nothing, which with a shared million-entry
# history is seldom. Set before the source line, since the plugin's own default
# is guarded by (( ! ${+ZSH_AUTOSUGGEST_STRATEGY} )).
#
# Not match_prev_cmd, which prefers whatever followed the command just run: it
# reads the in-memory $history, and SHARE_HISTORY interleaves every terminal's
# commands into that, so the adjacency it relies on is not there. Its own
# documented caveat, about HIST_IGNORE_ALL_DUPS and HIST_EXPIRE_DUPS_FIRST
# reordering history, we do satisfy -- neither is set.
#
# One thing to watch. The history strategy globs the whole in-memory list, so
# its cost grows with HISTSIZE: measured here, 0.1ms per lookup at a thousand
# entries, 0.6ms at ten thousand, 6ms at a hundred thousand and 35ms at the
# million HISTSIZE allows. Async fetching means that never blocks a keystroke,
# but once the history fills up the suggestion will visibly trail the cursor.
# If it ever does, drop `history' from the list below and leave completion --
# shrinking HISTSIZE is the wrong trade, the deep history being the point.
ZSH_AUTOSUGGEST_STRATEGY=(history completion)

# Stop looking for a suggestion past a thousand characters. Unlike
# highlighting, the cost here does not come from the line's length -- it comes
# from the size of the history being scanned, see HISTSIZE above -- so this is
# less about speed than about not bothering: a prefix that long has no useful
# match left to offer.
ZSH_AUTOSUGGEST_BUFFER_MAX_SIZE=1000

# The grey is ZSH_AUTOSUGGEST_HIGHLIGHT_STYLE='fg=8' by default, worth raising
# if it reads too dark.

# A loop because the path differs per platform and the file may not be there at
# all: brew on apple silicon, brew on intel, debian's own package.
for _f in /opt/homebrew/share/zsh-autosuggestions/zsh-autosuggestions.zsh \
          /usr/local/share/zsh-autosuggestions/zsh-autosuggestions.zsh \
          /usr/share/zsh-autosuggestions/zsh-autosuggestions.zsh; do
    if [[ -r $_f ]]; then
        source $_f
        break
    fi
done
unset _f

# ------------------------------------------------------------
# zsh-syntax-highlighting: colours the line as it is typed. Also zsh-users,
# and independent of autosuggestions above -- neither needs the other -- but
# the two are coupled at runtime, see the ordering note below.
#
# The useful part is unknown-token, fg=red,bold by default: a mistyped command
# goes red before return is pressed. Beside it arg0 is green for a command that
# resolves, path underlined for a file that exists, reserved-word yellow,
# quoted strings yellow, globs and history expansions blue.
#
# One default to know about: comment is fg=black,bold, i.e. bright black, which
# on a dark background can be all but unreadable. ZSH_HIGHLIGHT_STYLES[comment]
# is the fix if it matters -- comments at an interactive prompt are rare enough
# to ignore for now.
#
# main is the default and the only highlighter enabled unless asked; brackets
# is added here, which pairs up (), [] and {} by colour and reddens an
# unbalanced one. The other five shipped -- cursor, line, pattern, regexp, root
# -- are off: pattern and regexp need rules written for them, the rest are
# situational.
ZSH_HIGHLIGHT_HIGHLIGHTERS=(main brackets)

# Sourced after autosuggestions, and that order is the one thing the two
# plugins care about: both wrap the same ZLE widgets, and per the
# autosuggestions source, "highlighting breaks if our widgets are wrapped by
# zsh-syntax-highlighting widgets". Autosuggestions re-binds on every precmd
# precisely to stay on the outside, which is why
# ZSH_AUTOSUGGEST_MANUAL_REBIND must stay unset now that both are here.
#
# It re-highlights the whole buffer on every keystroke, so a long line -- a big
# paste above all -- lags. Measured here, per pass: 0.4ms at 100 characters,
# 0.7ms at 500, 1.1ms at 1000, 5.8ms at 5000, 33ms at 20000. Roughly linear
# past 500.
#
# 1000 therefore: six times the longest command in this history, where the
# median is 41 characters and the 99th percentile 157, and still only about a
# millisecond. Past that the line is a pasted blob rather than something being
# typed, which is exactly the case worth not highlighting.
#
# The path highlighting also stats files, which costs on a network filesystem.
ZSH_HIGHLIGHT_MAXLENGTH=1000
for _f in /opt/homebrew/share/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh \
          /usr/local/share/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh \
          /usr/share/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh; do
    if [[ -r $_f ]]; then
        source $_f
        break
    fi
done
unset _f

# Plain red for a command that does not resolve, where the default is
# fg=red,bold. Red alone is already unmistakable and the bold made it shout.
#
# After the source above, not before: the styles live in an associative array
# that the plugin declares as it loads, and its own defaults are applied with
# `: ${...:=}', which only fills in what is unset. Assigning afterwards simply
# overwrites.
ZSH_HIGHLIGHT_STYLES[unknown-token]='fg=red'

# Not here yet, compared with what .bashrc does for bash: the aliases from
# .bash_scripts/aliases.sh, `stty -ixon' to free C-s, LESS and GCC_COLORS, and
# kubectl's completion.
