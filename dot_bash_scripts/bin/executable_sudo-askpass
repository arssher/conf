#!/bin/bash
#
# sudo's askpass helper: asks for the password in a desktop dialog that names
# the command, for sudo run without a terminal. That is Claude Code's case --
# its commands have no tty, so sudo cannot prompt -- and ~/.sh_env points
# SUDO_ASKPASS here in Claude Code's shells only. With a terminal, sudo ignores
# the variable unless given -A.
#
# sudo runs this as you, with its prompt ("[sudo] password for ars: ") as the
# one argument, and reads the password from stdout. So the password goes from
# the dialog straight to sudo, and whatever ran sudo never sees it. Cancel, or
# the timeout, prints nothing, and sudo fails as it would have anyway.
#
# The command comes from sudo's own command line -- this helper's parent is
# the sudo process -- since sudo passes only the prompt, and a dialog asking
# for the root password should say what it is for.
#
# Two dialogs, one contract: zenity on linux, osascript on mac. Both are
# exec'd, so the password is never held by this shell, and both give up after
# 100 seconds -- inside Claude Code's default two-minute limit on a command, so
# the dialog closes before that limit kills the sudo waiting on it.

set -euo pipefail

prompt=${1:-Password:}

if [ "$(uname -s)" = Darwin ]; then
    # ps for the command line, macOS having no /proc.
    cmd=$(ps -o args= -p "$PPID" 2>/dev/null || true)

    # The AppleScript arrives on stdin and the two strings as arguments, so
    # nothing quoted inside a command line can be read as script. It trims the
    # command itself because display dialog grows to fit its text, and a long
    # enough one would push the buttons off the screen.
    #
    # A cancel raises -128 "User canceled" by itself; the timeout is given a
    # message of its own, so the two can be told apart in the log. Either way
    # osascript exits non-zero having printed nothing.
    exec osascript - "$cmd" "$prompt" <<'APPLESCRIPT'
on run argv
    set cmd to item 1 of argv
    if (count of cmd) > 300 then set cmd to (text 1 thru 300 of cmd) & "..."
    activate
    set answer to display dialog (cmd & linefeed & linefeed & (item 2 of argv)) ¬
        default answer "" with hidden answer ¬
        with title "sudo" with icon caution giving up after 100
    if gave up of answer then error "sudo-askpass: timed out" number -128
    return text returned of answer
end run
APPLESCRIPT
fi

if ! command -v zenity >/dev/null; then
    echo "sudo-askpass: not macOS and no zenity here; nothing to ask with" >&2
    exit 1
fi

# argv is NUL-separated; spaces read well enough.
cmd=$(tr '\0' ' ' < "/proc/${PPID}/cmdline")
cmd=${cmd% }

# zenity's --text is Pango markup, and a command can hold & < >.
escape() { sed -e 's/&/\&amp;/g' -e 's/</\&lt;/g' -e 's/>/\&gt;/g'; }

exec zenity --entry --hide-text --title=sudo --timeout=100 \
     --text="$(printf '%s\n\n%s' "$cmd" "$prompt" | escape)"
