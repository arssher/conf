# This file controls the behaviour of line input editing for
# programs that use the GNU Readline library.  Existing
# programs include FTP, Bash, and GDB.
#
# You can re-read the inputrc file with C-x C-r.
# Lines beginning with '#' are comments.

set editing-mode emacs

# qwerty row
"\ee": backward-kill-word
"\er": kill-word
"\eu": backward-word
"\ei": history-search-backward
"\eo": forward-word

# the home row
"\ed": backward-delete-char
"\ef": delete-char
"\eg": kill-line
"\eG": backward-kill-line
"\eh": beginning-of-line
"\eH": end-of-line
"\ej": backward-char
"\ek": history-search-forward
"\el": forward-char

# Option+arrow, which is how left cmd + u/o reaches a terminal on mac now --
# the ergoemacs scheme there uses real keys rather than ESC+letter, so that
# full-screen programs understand it too and not just readline-style line
# editors. ghostty is configured to send these CSI forms instead of its default
# ESC b / ESC f, since ESC f is already spoken for above.
#
# Harmless on linux, where a terminal sends the same sequences for alt+arrow
# and means the same thing by them.
"\e[1;3D": backward-word
"\e[1;3C": forward-word

# i and k search rather than merely step. readline takes everything between the
# start of the line and the cursor and looks for history entries beginning with
# it, so `git com' then M-i walks only the git com... commands. They were
# previous-history/next-history, which ignore what is already typed.
#
# The zsh half is up-line-or-beginning-search in .zshrc: the same thing, plus a
# move inside a multi-line buffer before it reaches for history. readline also
# has history-substring-search-backward/-forward, which match anywhere in the
# line rather than at its start -- not used, because zsh ships no equivalent and
# the two files have to agree.
#
# The bare arrows get the same two, as they do in .zshrc. xremap on linux and
# karabiner on mac send alt/cmd + i/k into a terminal as real up/down arrows,
# so that full-screen programs understand them, and \ei/\ek above then never
# arrive. Without these the gesture would drop back to previous-history.
# \e[A is what a terminal sends outside application mode, which readline does
# not turn on; /etc/inputrc and readline's defaults cover every other key the
# remap emits -- Home, End, ctrl+arrows, Delete, ctrl+k/u/w -- already.
"\e[A": history-search-backward
"\e[B": history-search-forward

