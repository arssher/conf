refcard

private/
etc/

# gtags output (gtags is run in subdirs, so match anywhere)
GPATH
GRTAGS
GTAGS

# virtualenv for the lyrics scripts in .bash_scripts/bin
.venv-lyrics/

# machine-local Claude Code permission overrides; this repo is public
**/.claude/settings.local.json

# Diagrams produced by dot_emacs.d/kbd-diagram/draw-kbd.sh. Regenerate them,
# do not commit them. (CLAUDE.md is the only .md here, so *.txt is safe to take wholesale.)
dot_emacs.d/kbd-diagram/*.txt
dot_emacs.d/kbd-diagram/*.svg
dot_emacs.d/kbd-diagram/*.png

# elpa packages. packages.el derives package-user-dir from the init.el being
# loaded, so loading the source copy rather than ~/.emacs.d/init.el installs
# them here instead of beside the applied config. The real ones live in
# ~/.emacs.d/elpa and belong to no repo.
dot_emacs.d/elpa/
